{
  "manifest_version": 3,
  "name": "Cloud Music · Save",
  "description": "Save audio detected while playing NetEase Cloud Music in your browser.",
  "version": "1.0.0",
  "minimum_chrome_version": "102",
  "permissions": ["downloads", "storage", "webRequest", "activeTab"],
  "host_permissions": ["*://music.163.com/*", "*://*.music.163.com/*", "*://*.music.126.net/*", "*://*.music.163.net/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Cloud Music · Save", "default_popup": "index.html"},
  "content_scripts": [{"matches": ["*://music.163.com/*", "*://*.music.163.com/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
